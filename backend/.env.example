MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=fathom_agents

# Signs short-lived access JWTs
JWT_SECRET=change-me
# HMAC key used to hash refresh tokens and OTPs before storing them
TOKEN_HMAC_SECRET=change-me-too
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
BCRYPT_ROUNDS=10

# Gmail that sends password-reset OTPs.
# OTP_EMAIL_APP_PASSWORD is a Google App Password, not the account password.
OTP_EMAIL=you@gmail.com
OTP_EMAIL_APP_PASSWORD=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# LiveKit — API key/secret for the backend; websocket URL for browser clients
LIVEKIT_URL=https://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WEBSOCKET_URL=wss://your-project.livekit.cloud
PUBLIC_APP_URL=http://localhost:5173

# AWS S3 — LiveKit Room Composite Egress destination
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Either name works:
S3_BUCKET=
AWS_S3_BUCKET=
S3_RECORDINGS_PREFIX=hive-recordings

# Google Gemini — meeting audio to transcript + summary
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
